{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/avatar-calibration.schema.json",
  "title": "SOMA Avatar Calibration Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "profile_id", "status", "soma_contract",
    "avatar", "mapping", "rest_calibration", "root_calibration",
    "scale_calibration", "ik", "validation"
  ],
  "properties": {
    "schema": {"const": "soma.avatar-calibration"},
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "validated"]},
    "soma_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "signature"],
      "properties": {
        "id": {"const": "soma77"},
        "version": {"type": "string", "minLength": 1},
        "signature": {"$ref": "#/$defs/signature"}
      }
    },
    "avatar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "asset_signature", "rig_signature"],
      "properties": {
        "format": {"type": "string", "minLength": 1},
        "asset_signature": {"type": "string", "minLength": 1},
        "rig_signature": {"$ref": "#/$defs/signature"}
      }
    },
    "mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["semantic", "soma_joint", "target_bone_id"],
        "properties": {
          "semantic": {"type": "string", "minLength": 1},
          "soma_joint": {"type": "string", "minLength": 1},
          "target_bone_id": {"type": "string", "minLength": 1},
          "target_parent_semantic": {"type": ["string", "null"]}
        }
      }
    },
    "rest_calibration": {
      "type": "object",
      "required": ["rotation_model", "per_bone"],
      "properties": {
        "rotation_model": {"type": "string", "minLength": 1},
        "source_motion_signature": {"type": ["string", "null"]},
        "source_frame": {"type": "integer", "minimum": 0},
        "per_bone": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/restCalibration"}
        }
      }
    },
    "root_calibration": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["unresolved", "calibrated"]},
        "source_joint": {"type": "string"},
        "target_bone_id": {"type": "string"},
        "source_rest_position_m": {"$ref": "#/$defs/vec3"},
        "target_rest_world_position_m": {"$ref": "#/$defs/vec3"},
        "translation_mode": {"type": "string"},
        "rotation_mode": {"type": "string"},
        "enabled_axes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["x", "y", "z"]}
        }
      }
    },
    "scale_calibration": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["unresolved", "calibrated"]},
        "method": {"type": "string"},
        "translation_scale": {"type": "number", "exclusiveMinimum": 0},
        "samples": {"type": "array"}
      }
    },
    "ik": {
      "type": "object",
      "required": ["enabled", "targets"],
      "properties": {
        "enabled": {"type": "boolean"},
        "pelvis_compensation": {
          "type": "object",
          "required": ["enabled", "max_lowering_m"],
          "properties": {
            "enabled": {"type": "boolean"},
            "max_lowering_m": {"type": "number", "minimum": 0}
          }
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "chain", "contact_channel", "contact_threshold", "ground_y",
              "lock_horizontal", "max_iterations", "tolerance_m"
            ],
            "properties": {
              "chain": {
                "type": "array",
                "minItems": 2,
                "items": {"type": "string"}
              },
              "contact_channel": {"type": "integer", "minimum": 0},
              "contact_threshold": {"type": "number"},
              "contact_hysteresis": {"type": "number", "minimum": 0},
              "ground_y": {"type": "number"},
              "sole_offset_m": {"type": "number"},
              "lock_horizontal": {"type": "boolean"},
              "lock_orientation": {"type": "boolean"},
              "orientation_tolerance_deg": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "lock_blend_frames": {"type": "integer", "minimum": 1},
              "pole_world_direction": {"$ref": "#/$defs/vec3"},
              "max_iterations": {"type": "integer", "minimum": 1},
              "tolerance_m": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        }
      }
    },
    "runtime_corrections": {
      "type": ["object", "null"],
      "properties": {
        "mode": {"type": "string", "minLength": 1},
        "root_position_mode": {
          "enum": ["add-delta-to-rest", "legacy-replace-xz-add-y"]
        },
        "translation_scale_override": {"type": "number", "exclusiveMinimum": 0},
        "ground_contact": {
          "type": "object",
          "required": [
            "enabled", "ground_y", "contact_threshold",
            "smoothing_factor", "contact_channels"
          ],
          "properties": {
            "enabled": {"type": "boolean"},
            "ground_y": {"type": "number"},
            "contact_threshold": {"type": "number"},
            "smoothing_factor": {"type": "number", "minimum": 0, "maximum": 1},
            "contact_channels": {
              "type": "object",
              "additionalProperties": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "validation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": [
            "suite_signature", "result_signature", "motion_signature",
            "profile_input_signature",
            "frames", "deterministic_runs", "repeat_canonical_delta"
          ],
          "properties": {
            "suite_signature": {"$ref": "#/$defs/signature"},
            "result_signature": {"$ref": "#/$defs/signature"},
            "motion_signature": {"$ref": "#/$defs/signature"},
            "qualification_motion_signature": {"$ref": "#/$defs/signature"},
            "profile_input_signature": {"$ref": "#/$defs/signature"},
            "frames": {"type": "array", "items": {"type": "integer", "minimum": 0}},
            "deterministic_runs": {"type": "integer", "minimum": 2},
            "repeat_canonical_delta": {"const": 0},
            "coverage": {
              "anyOf": [
                {"$ref": "#/$defs/mappingCoverage"},
                {"type": "null"}
              ]
            }
          }
        }
      ]
    },
    "authoring": {
      "type": "object",
      "properties": {
        "mapping_catalog": {
          "type": "object",
          "required": ["id", "version", "signature"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "signature": {"$ref": "#/$defs/signature"}
          }
        },
        "coverage": {"$ref": "#/$defs/mappingCoverage"},
        "validation_policy": {
          "type": "object",
          "properties": {
            "reference_direction_mean_deg_max": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "auto_tuning": {
          "type": "object",
          "required": [
            "solver", "solver_version", "source_motion_signature",
            "source_frame", "applied_semantics", "skipped_semantics",
            "mean_direction_error_deg_before",
            "mean_direction_error_deg_after", "suggestions"
          ],
          "properties": {
            "solver": {"const": "soma-reference-direction-fit"},
            "solver_version": {"type": "string", "minLength": 1},
            "source_motion_signature": {
              "oneOf": [
                {"$ref": "#/$defs/signature"},
                {"type": "null"}
              ]
            },
            "source_frame": {"type": "integer", "minimum": 0},
            "applied_semantics": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "skipped_semantics": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "mean_direction_error_deg_before": {"type": "number", "minimum": 0},
            "mean_direction_error_deg_after": {"type": "number", "minimum": 0},
            "suggestions": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/autoTuneSuggestion"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "signature": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "quaternion": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "number"}
    },
    "autoTuneSuggestion": {
      "type": "object",
      "required": [
        "original_offset_quaternion", "auto_offset_quaternion",
        "final_offset_quaternion", "manual_residual_quaternion",
        "confidence", "twist_status", "constraint_count",
        "child_semantics", "mean_direction_error_deg_before",
        "mean_direction_error_deg_after"
      ],
      "properties": {
        "original_offset_quaternion": {"$ref": "#/$defs/quaternion"},
        "auto_offset_quaternion": {"$ref": "#/$defs/quaternion"},
        "final_offset_quaternion": {"$ref": "#/$defs/quaternion"},
        "manual_residual_quaternion": {"$ref": "#/$defs/quaternion"},
        "confidence": {"enum": ["swing-only", "multi-axis"]},
        "twist_status": {"enum": ["unresolved", "constrained"]},
        "constraint_count": {"type": "integer", "minimum": 1},
        "child_semantics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "mean_direction_error_deg_before": {"type": "number", "minimum": 0},
        "mean_direction_error_deg_after": {"type": "number", "minimum": 0}
      }
    },
    "mappingCoverage": {
      "type": "object",
      "required": [
        "catalog_id", "catalog_version", "core_complete",
        "missing_required", "groups"
      ],
      "properties": {
        "catalog_id": {"type": "string", "minLength": 1},
        "catalog_version": {"type": "string", "minLength": 1},
        "core_complete": {"type": "boolean"},
        "missing_required": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["mapped", "total", "required"],
            "properties": {
              "mapped": {"type": "integer", "minimum": 0},
              "total": {"type": "integer", "minimum": 0},
              "required": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "restCalibration": {
      "type": "object",
      "required": [
        "status", "source_rest_world_quaternion",
        "source_rest_inverse_quaternion", "target_rest_world_quaternion",
        "target_parent_rest_world_quaternion",
        "target_parent_rest_world_position", "user_offset_quaternion"
      ],
      "properties": {
        "status": {"const": "captured"},
        "source_rest_world_quaternion": {"$ref": "#/$defs/quaternion"},
        "source_rest_inverse_quaternion": {"$ref": "#/$defs/quaternion"},
        "target_rest_world_quaternion": {"$ref": "#/$defs/quaternion"},
        "target_parent_rest_world_quaternion": {"$ref": "#/$defs/quaternion"},
        "target_parent_rest_world_position": {"$ref": "#/$defs/vec3"},
        "user_offset_quaternion": {"$ref": "#/$defs/quaternion"}
      }
    }
  }
}
