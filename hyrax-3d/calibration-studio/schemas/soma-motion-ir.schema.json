{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/soma-motion-ir.schema.json",
  "title": "SOMA Motion IR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "skeleton_id", "skeleton_version",
    "skeleton_signature", "motion_signature", "rotation_space", "rotation_representation", "fps",
    "frame_count", "joints", "parents", "global_rot_mats", "root_positions",
    "rest_offsets_m"
  ],
  "properties": {
    "schema": {"const": "soma.motion-ir"},
    "schema_version": {"const": "1.0.0"},
    "skeleton_id": {"const": "soma77"},
    "skeleton_version": {"type": "string", "minLength": 1},
    "skeleton_signature": {"$ref": "#/$defs/signature"},
    "motion_signature": {"$ref": "#/$defs/signature"},
    "rotation_space": {"const": "global"},
    "rotation_representation": {"const": "mat3-row-major"},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "frame_count": {"type": "integer", "minimum": 1},
    "joints": {
      "type": "array",
      "minItems": 77,
      "maxItems": 77,
      "items": {"type": "string", "minLength": 1}
    },
    "parents": {
      "type": "array",
      "minItems": 77,
      "maxItems": 77,
      "items": {"type": ["string", "null"]}
    },
    "global_rot_mats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 77,
        "maxItems": 77,
        "items": {"$ref": "#/$defs/mat3"}
      }
    },
    "root_positions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/vec3"}
    },
    "rest_offsets_m": {
      "type": "array",
      "minItems": 77,
      "maxItems": 77,
      "items": {"$ref": "#/$defs/vec3"}
    },
    "foot_contacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/vec4"}
    },
    "source": {"type": "object"}
  },
  "$defs": {
    "number": {"type": "number"},
    "signature": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "vec3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/number"}
    },
    "vec4": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/number"}
    },
    "mat3": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": {"$ref": "#/$defs/number"}
    }
  }
}
