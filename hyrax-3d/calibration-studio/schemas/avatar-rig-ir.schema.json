{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/avatar-rig-ir.schema.json",
  "title": "Avatar Rig IR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "rig_id", "rig_signature", "source",
    "coordinate_system", "bones"
  ],
  "properties": {
    "schema": {"const": "soma.avatar-rig-ir"},
    "schema_version": {"const": "1.0.0"},
    "rig_id": {"type": "string", "minLength": 1},
    "rig_signature": {"$ref": "#/$defs/signature"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format", "format_version", "asset_signature", "importer", "importer_version",
        "rig_space", "basis_correction"
      ],
      "properties": {
        "format": {"type": "string", "minLength": 1},
        "format_version": {"type": "string", "minLength": 1},
        "asset_signature": {"type": "string", "minLength": 1},
        "importer": {"type": "string", "minLength": 1},
        "importer_version": {"type": "string", "minLength": 1},
        "rig_space": {"enum": ["raw", "normalized"]},
        "basis_correction": {"type": "string", "minLength": 1}
      }
    },
    "coordinate_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "handedness", "up_axis", "forward_axis", "linear_unit"
      ],
      "properties": {
        "status": {"enum": ["declared", "unresolved"]},
        "handedness": {"type": "string", "minLength": 1},
        "up_axis": {"type": "string", "minLength": 1},
        "forward_axis": {"type": "string", "minLength": 1},
        "linear_unit": {"type": "string", "minLength": 1}
      }
    },
    "bones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "parent_id", "semantic", "rest_local", "rest_world"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "parent_id": {"type": ["string", "null"]},
          "semantic": {"type": ["string", "null"]},
          "rest_local": {"$ref": "#/$defs/transform"},
          "rest_world": {"$ref": "#/$defs/transform"}
        }
      }
    }
  },
  "$defs": {
    "signature": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "vec3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "number"}
    },
    "quat": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "number"}
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "quaternion", "scale"],
      "properties": {
        "position": {"$ref": "#/$defs/vec3"},
        "quaternion": {"$ref": "#/$defs/quat"},
        "scale": {"$ref": "#/$defs/vec3"}
      }
    }
  }
}
