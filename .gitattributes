# VRM 3D model files — stored via Git LFS
*.vrm filter=lfs diff=lfs merge=lfs -text

# Reviewed SFW Hyrax VN/HQ image package — keep binary artwork out of Git objects.
hyrax-assets/vn/**/*.png filter=lfs diff=lfs merge=lfs -text

# VNCCS emotion sprite suite — large binary artwork via Git LFS
hyrax-assets/essence/frames/*-emotion-*.png filter=lfs diff=lfs merge=lfs -text

# Compressed WebP thumbnails of the sprite suite — binary artwork via Git LFS
hyrax-assets/essence/frames/thumbs/*.webp filter=lfs diff=lfs merge=lfs -text
